# envpact dashboard environment variables
# STATIC site — only PUBLIC_ prefixed vars reach the browser.

# --- GitHub OAuth device flow (existing vault mechanism) ---
PUBLIC_GITHUB_OAUTH_CLIENT_ID=
PUBLIC_DASHBOARD_URL=https://envpact.oriz.in
PUBLIC_VAULT_REPO_DEFAULT=envpact-secrets

# --- Clerk (cross-subdomain SSO across *.oriz.in) ---
# Public content is NEVER gated; Clerk gates personal features only.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Firebase (shared oriz-in project, Firestore only — NOT auth) ---
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
