# envpact field station — build-time config. All PUBLIC_* (reach the browser).
# Copy to .env, fill, never commit real .env.

# Clerk (auth) — gates only the personal baseline; public reads stay open.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase (Firestore only — Clerk owns auth). Shared oriz-in project.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
