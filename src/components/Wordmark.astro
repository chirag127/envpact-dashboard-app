---
/*
 * Wordmark — `oriz · envpact` set in Zilla Slab with the middle `·`
 * replaced by a tiny oxidized-brass KEYHOLE glyph (round bow + notch).
 * The keyhole ties the wordmark to the cut-key hero — envpact is the
 * escutcheon you view your vault through. This mark is envpact-only:
 * sister sites use different middot motifs (cards = brass chip square).
 *
 * Links to https://oriz.in when `home` is set (the family wordmark),
 * otherwise to `/` (the dashboard root).
 */
interface Props {
  /** Sub-section label after a `/` separator, in brass. */
  subtitle?: string;
  /** Display size in px. Header lockup = 18. */
  size?: number;
  /** Link target. Pass "https://oriz.in" for the family mark. */
  href?: string | null;
  asHeading?: boolean;
}
const { subtitle, size = 18, href = null, asHeading = false } = Astro.props;
const Tag = asHeading ? 'h1' : 'div';
---

{href ? (
  <a class="wm-link" href={href} aria-label={subtitle ? `oriz envpact / ${subtitle}` : 'oriz envpact'}>
    <Tag class="wm" style={`--wm-size:${size}px;`}>
      <span class="wm-mark">
        <span class="wm-text">oriz</span>
        <span class="wm-keyhole" aria-hidden="true">
          <span class="wm-bow"></span>
          <span class="wm-blade"></span>
        </span>
        <span class="wm-text">envpact</span>
      </span>
      {subtitle && (
        <>
          <span class="wm-sep" aria-hidden="true">/</span>
          <span class="wm-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  </a>
) : (
  <Tag class="wm" style={`--wm-size:${size}px;`}>
    <span class="wm-mark">
      <span class="wm-text">oriz</span>
      <span class="wm-keyhole" aria-hidden="true">
        <span class="wm-bow"></span>
        <span class="wm-blade"></span>
      </span>
      <span class="wm-text">envpact</span>
    </span>
    {subtitle && (
      <>
        <span class="wm-sep" aria-hidden="true">/</span>
        <span class="wm-sub">{subtitle}</span>
      </>
    )}
  </Tag>
)}

<style>
  .wm-link { display: inline-block; color: inherit; text-decoration: none; }
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--wm-size, 18px);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--steel-bright);
  }
  .wm-mark { display: inline-flex; align-items: center; gap: 0.3em; }
  .wm-text { display: inline-block; }
  /* Oxidized-brass keyhole: round bow over a tapered blade slot. */
  .wm-keyhole {
    position: relative;
    display: inline-block;
    width: 0.56em;
    height: 0.86em;
    translate: 0 0.02em;
  }
  .wm-bow {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--brass-light) 0%, var(--brass) 55%, var(--brass-deep) 100%);
    box-shadow: 0 0 0 0.5px var(--brass-deep);
  }
  .wm-blade {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 0.2em;
    height: 0.44em;
    background: linear-gradient(180deg, var(--brass) 0%, var(--brass-deep) 100%);
    clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%);
  }
  .wm-sep { margin-inline: 0.12em; color: var(--steel-mute); font-weight: 400; }
  .wm-sub { color: var(--brass); font-weight: 500; letter-spacing: 0.02em; }
  .wm-link:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; border-radius: 2px; }
</style>
