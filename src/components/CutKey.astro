---
/*
 * Cut-Key figure — the hero thesis. A safe-deposit key drawn in
 * oxidized brass on the blued plate; the blade's bitting teeth animate
 * once on load, each rising to its cut depth (envpact "cuts" your
 * project .env from the vault's bitting code). Reduced-motion: static.
 *
 * Bitting code below the key = the KPI eyebrow made literal. Depths are
 * arbitrary but read as a real 6-pin code (0-9 per position).
 */
const bitting = [3, 7, 2, 8, 4, 6];
// Blade geometry: teeth sit along the bottom edge, cut UP from a baseline.
const bladeX = 96;
const bladeW = 200;
const step = bladeW / bitting.length;
const baseY = 116; // bottom edge of blade
const maxCut = 26;
---

<figure class="keyfig">
  <svg viewBox="0 0 340 190" role="img" aria-label="Cut safe-deposit key with a six-position bitting code">
    <defs>
      <linearGradient id="brass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--brass-light)" />
        <stop offset="0.55" stop-color="var(--brass)" />
        <stop offset="1" stop-color="var(--brass-deep)" />
      </linearGradient>
      <linearGradient id="brass-edge" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="var(--brass-deep)" />
        <stop offset="1" stop-color="var(--brass-light)" />
      </linearGradient>
    </defs>

    <!-- Key bow (round head + keyhole) -->
    <circle cx="52" cy="96" r="42" fill="url(#brass)" stroke="var(--brass-deep)" stroke-width="1.5" />
    <circle cx="52" cy="96" r="30" fill="none" stroke="var(--brass-deep)" stroke-width="1" opacity="0.7" />
    <!-- keyhole cut into the bow -->
    <circle cx="52" cy="86" r="9" fill="var(--plate)" />
    <path d="M47 90 L57 90 L60 112 L44 112 Z" fill="var(--plate)" />

    <!-- Shank -->
    <rect x="90" y="86" width="20" height="20" fill="url(#brass)" stroke="var(--brass-deep)" stroke-width="1" />

    <!-- Blade shaft (top edge, straight) -->
    <rect x={bladeX} y="86" width={bladeW} height="8" fill="url(#brass-edge)" />

    <!-- Bitting teeth — animate up to cut depth -->
    {bitting.map((depth, i) => {
      const x = bladeX + i * step;
      const h = 8 + (maxCut - (depth / 9) * maxCut) + 6;
      return (
        <rect
          class="key-tooth"
          x={x + 1}
          y={baseY - h}
          width={step - 2}
          height={h}
          fill="url(#brass)"
          stroke="var(--brass-deep)"
          stroke-width="0.75"
          style={`animation-delay:${0.15 + i * 0.07}s`}
        />
      );
    })}
    <!-- tip -->
    <path d={`M${bladeX + bladeW} 86 l14 0 l-6 30 l-8 0 Z`} fill="url(#brass)" stroke="var(--brass-deep)" stroke-width="0.75" class="key-tooth" style="animation-delay:0.6s" />
  </svg>
  <figcaption class="keyfig-caption">
    <span>bitting {bitting.join('·')}</span>
    <span>envpact-secrets</span>
  </figcaption>
</figure>
