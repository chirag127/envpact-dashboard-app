---
import SignInPanel from '../components/SignInPanel';

const title = 'envpact — sign in';
const description = 'Sign in to the oriz.in family via Clerk SSO. The envpact vault stays keyed to your own GitHub account.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Inter+Tight:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap"
    />
    <title>{title}</title>
    <style is:global>
      :root {
        --night: #0b0e1a;
        --night-2: #0e1222;
        --panel: #151a2e;
        --ridge: #232a48;
        --line: #202744;
        --bone: #f2eef6;
        --muted: #8a8fa8;
        --oxide: #e8622c;
        --cut: #4fd6e0;
        --font-display: 'Syne', 'Arial Narrow', system-ui, sans-serif;
        --font-ui: 'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'Space Mono', 'SFMono-Regular', Consolas, monospace;
        --radius: 4px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(900px 500px at 88% -12%, rgba(79, 214, 224, 0.07), transparent 60%),
          radial-gradient(760px 420px at 4% -6%, rgba(232, 98, 44, 0.06), transparent 62%),
          var(--night);
        color: var(--bone);
        font-family: var(--font-ui);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--cut); text-decoration: none; }
      a:hover { color: var(--cut); text-decoration: underline; text-underline-offset: 3px; }
      header.site {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 26px;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 20px;
        letter-spacing: -0.01em;
        color: var(--bone);
      }
      .brand .word b { color: var(--oxide); }
      .signin-wrap {
        max-width: 460px;
        margin: 0 auto;
        padding: 56px 26px 96px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 10px;
      }
      .serial {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .signin-wrap h2 {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 28px;
        letter-spacing: -0.01em;
        margin: 4px 0 0;
      }
      .signin-wrap p.note { color: var(--muted); font-size: 14px; margin: 0 0 18px; }
      .signin-mount { min-height: 400px; display: flex; justify-content: center; width: 100%; }
    </style>
  </head>
  <body>
    <header class="site">
      <a href="/" class="brand"><span class="word">env<b>pact</b></span></a>
      <a href="/" class="serial">&larr; back</a>
    </header>
    <main class="signin-wrap">
      <span class="serial">oriz.in SSO · CLERK</span>
      <h2>Sign in to envpact</h2>
      <p class="note">Public docs stay open. Sign in only to sync vault preferences.</p>
      <div class="signin-mount">
        <SignInPanel client:only="react" />
      </div>
    </main>
  </body>
</html>
