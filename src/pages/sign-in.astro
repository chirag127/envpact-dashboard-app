---
import Station from '../layouts/Station.astro';
import SignInPanel from '../components/SignInPanel';

const title = 'envpact field station — sign in';
const description = 'Sign in to the oriz.in family via Clerk SSO. Public station reads stay open; sign in to keep a personal baseline.';
---

<Station title={title} description={description}>
  <section class="band">
    <div class="wrap signin-wrap">
      <span class="chan">CH·<b>ENV</b> / OPERATOR ACCESS / oriz.in SSO</span>
      <h2 class="signin-h">Sign in to the station</h2>
      <p class="signin-note">Public readings stay open to everyone. Sign in only to pin a personal baseline across the oriz.in family.</p>
      <div class="signin-mount">
        <SignInPanel client:only="react" />
      </div>
    </div>
  </section>

  <style>
    .signin-wrap {
      max-width: 480px;
      margin: 0 auto;
      padding: 48px 0 72px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }
    .chan {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--haze);
    }
    .chan b { color: var(--verdigris); }
    .signin-h {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(28px, 4vw, 38px);
      color: var(--chalk);
      margin: 4px 0 0;
    }
    .signin-note { color: var(--haze); font-size: 14px; margin: 0 0 18px; max-width: 40ch; }
    .signin-mount { min-height: 400px; display: flex; justify-content: center; width: 100%; }
  </style>
</Station>
