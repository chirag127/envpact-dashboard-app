---
import BaseLayout from '../layouts/BaseLayout.astro';
import CutKey from '../components/CutKey.astro';

const title = 'envpact — the vault escutcheon';
const description =
  'View your envpact secrets vault through the browser. Keys live in your own private GitHub repo; the dashboard reads them via GitHub OAuth — no envpact server, no third-party storage.';
---

<BaseLayout title={title} description={description}>
  <main>
    <!-- HERO — cut-key thesis. Signed-in JS hides #marketing; this
         block is the first-visit pitch. -->
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-eyebrow">your vault · your keys · your account</p>
        <h1>Cut a clean <em>.env</em> from a vault only you can open.</h1>
        <p class="hero-lede">
          Your secrets live in <code>&lt;you&gt;/envpact-secrets</code> — a
          private GitHub repo. This dashboard is the escutcheon: it reads and
          writes that vault straight from your browser via the GitHub API. No
          envpact server ever sees a token.
        </p>
        <div class="hero-cta">
          <a class="btn" href="#connect">Open your vault</a>
          <a class="btn secondary" href="https://chirag127.github.io/envpact/" rel="noopener">Read the docs</a>
        </div>
      </div>
      <CutKey />
    </section>

    <!-- Marketing block (hidden by index.js once GitHub-signed-in). -->
    <section class="marketing" id="marketing">
      <h2 data-seq="A">How the vault works</h2>
      <p class="tagline">
        One centralized secrets manager for every AI coding agent. Define a key
        once in <strong>shared</strong>; every project that references it picks up
        the new value on the next run. One rotate updates them all.
      </p>

      <div class="feature-grid">
        <div class="feature-card" data-tag="VAULT">
          <h3>Your vault, your account</h3>
          <p>Secrets sit in <code>&lt;you&gt;/envpact-secrets</code> on GitHub — a private repo only you can read. envpact never holds a token of yours.</p>
        </div>
        <div class="feature-card" data-tag="SHARED">
          <h3>One key, many projects</h3>
          <p>Set <code>OPENAI_API_KEY</code> once in shared. Every project that references <code>shared.OPENAI_API_KEY</code> resolves the new value next run.</p>
        </div>
        <div class="feature-card" data-tag="AGENTS">
          <h3>Works with your agent</h3>
          <p>MCP server for Claude Code, Cursor, Windsurf, Cline, Goose. Plus CLI, VS Code extension, GitHub Action, Python module.</p>
        </div>
        <div class="feature-card" data-tag="BROWSER">
          <h3>Browser-only dashboard</h3>
          <p>This page reads and writes your vault directly via the GitHub API. Your token stays in this tab's session only.</p>
        </div>
      </div>

      <div class="install-block">
        <span class="comment"># add envpact to any agent that speaks MCP</span><br />
        <span class="cmd">npx -y envpact-mcp</span><br /><br />
        <span class="comment"># or generate .env from your vault with the CLI</span><br />
        <span class="cmd">npx -y envpact-cli</span>
      </div>

      <p class="components">
        Components:
        <a href="https://github.com/chirag127/envpact-cli"><strong>CLI</strong></a> ·
        <a href="https://github.com/chirag127/envpact-mcp"><strong>MCP server</strong></a> ·
        <a href="https://github.com/chirag127/envpact-action"><strong>GitHub Action</strong></a> ·
        <a href="https://marketplace.visualstudio.com/items?itemName=chirag127.envpact"><strong>VS Code</strong></a> ·
        <a href="https://pypi.org/project/envpact/"><strong>Python</strong></a>
      </p>
    </section>

    <!-- #app — the vault dashboard (rendered by /scripts/index.js).
         Contains .login-hero + #login-btn when signed out of GitHub. -->
    <div id="app">
      <h2 id="connect" data-seq="B">Connect your vault</h2>
      <div class="panel">
        <div class="login-hero">
          <h2>Sign in with GitHub to open your vault</h2>
          <p>
            Your envpact-secrets repo is the single source of truth. This
            dashboard reads and writes it directly from your browser — no backend.
          </p>
          <button id="login-btn">Connect GitHub</button>
          <div class="privacy-note">
            <strong>Privacy model:</strong> your access token is stored only in
            this tab's <code>sessionStorage</code> (cleared on close). Every API
            call goes straight to <code>api.github.com</code>. No envpact server
            is involved.
          </div>
        </div>
      </div>
    </div>

    <div id="pinned-mount"></div>
  </main>

  <script type="module" src="/scripts/index.js"></script>
</BaseLayout>
